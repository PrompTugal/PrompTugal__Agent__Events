From aa3a89f2d88aab6c5bf3eb9f57ea310f20d59224 Mon Sep 17 00:00:00 2001
From: "cl-6.events@PrompTugal.dinis" <cl-6.events@PrompTugal.dinis>
Date: Fri, 27 Nov 2026 02:43:13 +0000
Subject: [PATCH] cl-6.events@PrompTugal.dinis: release.sh pushes to
 work/<agent> and waits for the gate (proposal)

Agent: cl-6.events@PrompTugal.dinis
Claude-Session: https://claude.ai/code/session_016CrbJNMHQRQmkvWGwFt7BL
Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 scripts/release.sh | 23 ++++++++++++++++++++---
 1 file changed, 20 insertions(+), 3 deletions(-)

diff --git a/scripts/release.sh b/scripts/release.sh
index 4fa31b9..4336f2d 100755
--- a/scripts/release.sh
+++ b/scripts/release.sh
@@ -59,9 +59,16 @@ trusted_check() {
   rm -rf "$d"; return $rc
 }
 trusted_check
+AGENT_NAME=cl-6.events; WORK="work/cl-6.events"   # hard-coded, never from the environment (cl-6.security, 27 Nov 2026)
 for i in 1 2 3 4 5; do
   git fetch -q origin dev
-  git rebase -q origin/dev
+  # First pass: rebase. Later passes (dev moved while the work branch holds our earlier commit): merge dev in with a signed merge
+  # commit instead, so the push to work/<agent> is a plain fast-forward and nothing is ever force-pushed (R5).
+  if [ "$i" = 1 ]; then git rebase -q origin/dev
+  else git merge -q --no-edit -m "$AGENT_NAME@PrompTugal.dinis: merge dev into $WORK
+
+Agent: $AGENT_NAME@PrompTugal.dinis
+Claude-Session: ${CLAUDE_SESSION_URL:?set CLAUDE_SESSION_URL to the session URL published with the key}" origin/dev; fi
   # One gate per line: under set -e a failure inside an && chain does not stop the script (specialist.code@ finding 1).
   node scripts/check-data.mjs >/dev/null
   node scripts/build.mjs >/dev/null
@@ -69,7 +76,17 @@ for i in 1 2 3 4 5; do
   node scripts/leak-scan.mjs >/dev/null
   node scripts/check-commits.mjs origin/dev HEAD >/dev/null
   trusted_check >/dev/null
-  if git -c push.negotiate=true push -q origin HEAD:dev; then echo "released $(git rev-parse --short HEAD) to dev"; exit 0; fi
-  sleep $((i * 3))
+  # With the dev-gate on (PrompTugal__IaC docs/key-bootstrap.md, "With dev-gate on"): never push dev. Push the release commit to
+  # work/<agent>; the IaC App gives it its status and fast-forwards dev. Never force-push: a rejected push stops the release.
+  SHA=$(git rev-parse HEAD); BASE=$(git rev-parse origin/dev)
+  git -c push.negotiate=true push -q origin "HEAD:refs/heads/$WORK" || { echo "the push to $WORK was refused: stopping (no force-push)" >&2; exit 1; }
+  # Every 90 seconds, for about 20 minutes: dev equal to our SHA means released; a tag gate/<agent>/<sha12>-fail (agent = the name after work/, sha12 = the first 12 hex of the refused head) means refused.
+  for t in $(seq 1 14); do
+    sleep 90
+    [ "$(git ls-remote origin refs/heads/dev | cut -f1)" = "$SHA" ] && { echo "released ${SHA:0:7} to dev through $WORK"; exit 0; }
+    if [ -n "$(git ls-remote --tags origin "refs/tags/gate/cl-6.events/${SHA:0:12}-fail")" ]; then echo "the gate refused ${SHA:0:12}: stopping and reporting" >&2; exit 1; fi
+    [ "$(git ls-remote origin refs/heads/dev | cut -f1)" != "$BASE" ] && { echo "dev moved: rebasing and pushing again"; continue 2; }
+  done
+  echo "no result for ${SHA:0:12} after about 20 minutes: stopping" >&2; exit 1
 done
 echo "release failed after 5 attempts" >&2; exit 1
-- 
